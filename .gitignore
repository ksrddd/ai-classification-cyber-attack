# ============================================================
# Cyber Attack Classification — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
catboost_info/
venv/
env/
.env
.python-version
*.egg-info/
build/
dist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Lint / format caches ---
.ruff_cache/
.mypy_cache/
.dmypy.json

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Data: never commit raw CICIDS2017 (multi-GB, license-restricted) ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# data/sample/ IS committed — small stratified subset for tests + dashboard demo

# --- Generated run bundles (everything under results/ is regenerable) ---
# Metrics, reports and the champion pointer stay tracked so a clone can read
# the published numbers without retraining; the heavy binaries do not.
results/**/*.joblib
results/**/*.pkl
results/**/*.png
results/**/checkpoints/
results/**/shap/
results/coverage/

# --- Logs ---
logs/*.log
logs/*.jsonl
!logs/.gitkeep

# --- CatBoost training scratch ---
catboost_info/

# --- Streamlit ---
.streamlit/secrets.toml

CLAUDE.md