# ============================================================
# Cyber Attack Classification — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
.python-version
*.egg-info/
build/
dist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Lint / format caches ---
.ruff_cache/
.mypy_cache/
.dmypy.json

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Data: never commit raw CICIDS2017 (multi-GB, license-restricted) ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# data/sample/ IS committed — small stratified subset for tests + dashboard demo

# --- Generated run bundles (everything under results/ is regenerable) ---
# Metrics, reports and the champion pointer stay tracked so a clone can read
# the published numbers without retraining; the heavy binaries do not.
results/**/*.joblib
results/**/*.pkl
results/**/*.png
results/**/checkpoints/
results/**/shap/
results/coverage/

# Wrapper logs from ad-hoc overnight runner scripts, which land beside the
# bundles rather than inside one. The pipeline's own train_ids2018.log carries
# the same run in full detail and stays tracked; these hold only start/exit
# lines. The pattern stops at one level on purpose -- results/ids2018/*.log
# does not match results/ids2018/<bundle>/runner.log, and two of those are
# already committed.
results/ids2018/*.log

# Superseded or throwaway cross-dataset runs. A leading underscore marks a
# bundle that was kept on disk only long enough to diff against its successor
# -- `_v1_unseeded_models`, for instance, reported five seeds that were really
# one run repeated, because the loop seed never reached the estimators.
# Committing those invites someone to quote a number the project has already
# retracted; what changed between rounds is written up in
# docs/experiments/crossdataset/README.md instead.
results/crossdataset/_*

# --- Trained model binaries (CSE-CIC-IDS2018 pipeline writes here) ---
# 197 MB across the two 300k bundles, largest single file 44 MB. All of it is
# regenerable from the cached sample in ~2 min. metadata.json is kept because
# it records the feature order, dropped columns, class list and seed -- the
# only part a clone needs to interpret the tracked metrics.
models/**
!models/**/
!models/**/metadata.json

# --- CSE-CIC-IDS2018 sample cache ---
# sample_<size>.parquet is the extracted stratified sample (35 MB at 300k);
# corpus_label_index.npz is the pass-1 scan. Both rebuild from the raw CSVs.
data/ids2018/

# --- Logs ---
logs/*.log
logs/*.jsonl
!logs/.gitkeep

# --- CatBoost training scratch ---
catboost_info/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Local editor / tooling state ---
# Per-machine configuration: absolute interpreter paths, local run profiles and
# per-user preferences. None of it is portable -- the committed launch profile
# still pointed at D:/Projects/Senior Project/, a path this repo no longer lives
# at -- and none of it is needed to run, train or reproduce anything here.
.claude/
.impeccable/
CLAUDE.md

# --- Captured DOM snapshots of the dashboard (docs/design/figma-export/) ---
# overview-dark.html and overview-light.html are saved-from-browser dumps: 67 KB
# each, of which the same 46 KB of compiled Tailwind reset is duplicated
# verbatim between them. Nothing in this repo regenerates them -- they were
# captured by hand from a running dev server as a stepping stone into Figma.
# What they carried now lives in three tracked-or-published places instead:
# make-brief.md (the written system), screens/*.jpg (the visual reference) and
# the Figma file itself (the design as real layers). Keep them locally if you
# still want the html.to.design import path; they just don't need pushing.
docs/design/figma-export/overview-*.html
